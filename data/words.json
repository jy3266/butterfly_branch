[
  {
    "id": 1,
    "text": "배가 고프네요.",
    "createdAt": "2026-10-02T00:00:00.000Z"
  },
  {
    "id": 2,
    "text": "사랑해",
    "createdAt": "2026-10-02T00:00:00.000Z"
  },
  {
    "id": 3,
    "text": "습하고 찝찝한거 싫다",
    "createdAt": "2026-10-02T00:00:00.000Z"
  },
  {
    "id": 4,
    "text": "아 오늘 비 안 온댔는데",
    "createdAt": "2026-10-02T00:00:00.000Z"
  },
  {
    "id": 5,
    "text": "짜증나",
    "createdAt": "2026-10-02T00:00:00.000Z"
  },
  {
    "id": 6,
    "text": "배가 아프다 오늘은",
    "createdAt": "2026-10-02T00:00:00.000Z"
  },
  {
    "id": 7,
    "text": "비에 내 몸을 맡기며 하늘을 바라보고 눕는 상상",
    "createdAt": "2026-10-02T00:00:00.000Z"
  },
  {
    "id": 8,
    "text": "기분이 좋은 것 같아",
    "createdAt": "2026-10-02T00:00:00.000Z"
  },
  {
    "id": 9,
    "text": "드라마 생각을 하는 편이다.",
    "createdAt": "2026-10-02T00:00:00.000Z"
  },
  {
    "id": 10,
    "text": "밤에 길거리를 걸으며 듣던 존메이어의 노래",
    "createdAt": "2026-10-02T00:00:00.000Z"
  },
  {
    "id": 11,
    "text": "비를 함께 맞던 사람 생각",
    "createdAt": "2026-10-02T00:00:00.000Z"
  },
  {
    "id": 12,
    "text": "우산 안챙겼다",
    "createdAt": "2026-10-02T00:00:00.000Z"
  },
  {
    "id": 13,
    "text": "감성팔이 하지말고 집 가서 발 닦고 자자",
    "createdAt": "2026-10-02T00:00:00.000Z"
  },
  {
    "id": 14,
    "text": "기분 좋은 고립이 시작되었네",
    "createdAt": "2026-10-02T00:00:00.000Z"
  },
  {
    "id": 15,
    "text": "점심시간에 비를 맞던 친구가 생각난다.",
    "createdAt": "2026-10-02T00:00:00.000Z"
  },
  {
    "id": 16,
    "text": "아 습한 거 싫은데..",
    "createdAt": "2026-10-02T00:00:00.000Z"
  },
  {
    "id": 17,
    "text": "ㅎㅇㅎㅇㅎㅇㅎㅇ",
    "createdAt": "2026-10-02T00:00:00.000Z"
  },
  {
    "id": 18,
    "text": "the earth is replenished",
    "createdAt": "2026-10-02T00:00:00.000Z"
  },
  {
    "id": 19,
    "text": "튀김 먹고 싶다",
    "createdAt": "2026-10-02T00:00:00.000Z"
  },
  {
    "id": 20,
    "text": "비 이야기가 나오는 노래를 흥얼거린다",
    "createdAt": "2026-10-02T00:00:00.000Z"
  },
  {
    "id": 21,
    "text": "그냥 웃는 일이 가득했으면 좋겠어.",
    "createdAt": "2026-10-02T00:00:00.000Z"
  },
  {
    "id": 22,
    "text": "우산이없어 비를 맞으며 집에 들어갔던 기억",
    "createdAt": "2026-10-02T00:00:00.000Z"
  },
  {
    "id": 23,
    "text": "비가 와서 우산이 없는 날에는 슬퍼짐",
    "createdAt": "2026-10-02T00:00:00.000Z"
  },
  {
    "id": 24,
    "text": "When my mum died i felt alone",
    "createdAt": "2026-10-02T00:00:00.000Z"
  },
  {
    "id": 25,
    "text": "앞머리 뽕 죽겠다.",
    "createdAt": "2026-10-02T00:00:00.000Z"
  },
  {
    "id": 26,
    "text": "오래 보고싶다 이 순간을",
    "createdAt": "2026-10-02T00:00:00.000Z"
  },
  {
    "id": 27,
    "text": "비 온다",
    "createdAt": "2026-10-02T00:00:00.000Z"
  },
  {
    "id": 28,
    "text": "창 안에 있어서 안전하다. 밖을 바라보는것이 좋다. 만물이 갈증을 해결하고 있구나.",
    "createdAt": "2026-10-02T00:00:00.000Z"
  },
  {
    "id": 29,
    "text": "행복하고 싶은 마음인것 같아.",
    "createdAt": "2026-10-02T00:00:00.000Z"
  },
  {
    "id": 30,
    "text": "놀이터에서 모래 놀이 하던 추억",
    "createdAt": "2026-10-02T00:00:00.000Z"
  },
  {
    "id": 31,
    "text": "비오면 강아지들 산책 못하는데",
    "createdAt": "2026-10-02T00:00:00.000Z"
  },
  {
    "id": 32,
    "text": "이모 오늘 재미있었어요~",
    "createdAt": "2026-10-02T00:00:00.000Z"
  },
  {
    "id": 33,
    "text": "새로운 시작",
    "createdAt": "2026-10-02T00:00:00.000Z"
  },
  {
    "id": 34,
    "text": "행복하다 :)",
    "createdAt": "2026-10-04T15:00:16.791Z"
  },
  {
    "id": 35,
    "text": "뭘해야하지",
    "createdAt": "2026-10-04T15:36:33.221Z"
  },
  {
    "id": 36,
    "text": "휴..",
    "createdAt": "2026-10-04T15:36:33.222Z"
  },
  {
    "id": 37,
    "text": "나의 생각 전달",
    "createdAt": "2026-10-04T15:51:00.622Z"
  },
  {
    "id": 38,
    "text": "헤헤헤헤",
    "createdAt": "2026-10-04T16:00:38.318Z"
  },
  {
    "id": 39,
    "text": "흠..배가 고프다아..",
    "createdAt": "2026-10-04T16:17:00.153Z"
  },
  {
    "id": 40,
    "text": "글쎄에에..",
    "createdAt": "2026-10-04T16:35:02.211Z"
  }
]